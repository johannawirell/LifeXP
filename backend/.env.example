# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports
API_GATEWAY_PORT=3000
# Internal auth-service port. Frontend går via api-gateway på port 3000.
AUTH_SERVICE_PORT=3005
AUTH_SERVICE_URL=http://localhost:3005
USER_SERVICE_PORT=3001
USER_SERVICE_URL=http://localhost:3001
GOALS_SERVICE_PORT=3002
GOALS_SERVICE_URL=http://localhost:3002
ANALYTICS_SERVICE_PORT=3003
ANALYTICS_SERVICE_URL=http://localhost:3003
GAMIFICATION_SERVICE_PORT=3004
GAMIFICATION_SERVICE_URL=http://localhost:3004

# JWT
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
# Krävs nu för fungerande Google login via web/browser OAuth.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Måste matcha Authorized redirect URI i Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Förberedda för framtida native sign-in. Behövs inte för nuvarande browser-flöde.
GOOGLE_ANDROID_CLIENT_ID=replace-with-google-android-client-id
GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id

# Apple OAuth
# Krävs först när Apple login aktiveras.
APPLE_CLIENT_ID=replace-with-apple-services-id
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-apple-private-key\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=http://localhost:3000/api/auth/apple/callback

# Auth redirect targets
# Appens redirect tillbaka från OAuth.
AUTH_ALLOWED_REDIRECT_URIS=myapp://auth/callback,http://localhost

# Service database URLs
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_auth?schema=public
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_user?schema=public
GOALS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_goals?schema=public
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_analytics?schema=public
GAMIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_gamification?schema=public
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifexp_notification?schema=public
