generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("GOALS_DATABASE_URL")
}

model Goal {
  id              String         @id @default(uuid())
  userId          String
  title           String
  icon            String?
  subtitle        String?
  description     String?
  category        String?
  difficulty      GoalDifficulty @default(MEDIUM)
  goalXpReward    Int            @default(0)
  totalXpReward   Int            @default(0)
  status          GoalStatus     @default(ACTIVE)
  targetValue     Decimal?
  currentValue    Decimal?
  unit            String?
  percentLabel    String?
  cardColor       String?
  streakDays      Int?
  startDate       DateTime?
  targetDate      DateTime?
  completedAt     DateTime?
  completedXpGrantedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  milestones      Milestone[]
  progressEntries ProgressEntry[]
  schedules       GoalSchedule[]

  @@index([userId, status])
}

model Milestone {
  id          String            @id @default(uuid())
  goalId      String
  title       String
  description String?
  xpReward    Int               @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  xpGrantedAt DateTime?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  goal        Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  subtasks    MilestoneSubtask[]
  tips        MilestoneTip[]

  @@index([goalId])
}

model MilestoneSubtask {
  id          String    @id @default(uuid())
  milestoneId String
  title       String
  completed   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, position])
}

model MilestoneTip {
  id          String    @id @default(uuid())
  milestoneId String
  text        String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, position])
}

model ProgressEntry {
  id         String    @id @default(uuid())
  goalId      String
  value       Decimal?
  note        String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
}

model GoalSchedule {
  id             String    @id @default(uuid())
  goalId          String
  frequency       String
  interval        Int       @default(1)
  daysOfWeek      String[]
  reminderTime    String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  goal            Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalTemplate {
  id                 String               @id @default(uuid())
  title              String
  icon               String
  subtitle           String
  summaryDescription String
  detailDescription  String
  category           GoalTemplateCategory
  difficulty         GoalDifficulty      @default(MEDIUM)
  goalXpReward       Int                 @default(0)
  totalXpReward      Int                 @default(0)
  color              String
  isPopular          Boolean              @default(false)
  position           Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  milestones         GoalTemplateMilestone[]
  details            GoalTemplateDetail[]

  @@index([category, position])
}

model GoalTemplateMilestone {
  id             String                       @id @default(uuid())
  goalTemplateId String
  title          String
  description    String?
  xpReward       Int                          @default(0)
  position       Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  goalTemplate   GoalTemplate                 @relation(fields: [goalTemplateId], references: [id], onDelete: Cascade)
  subtasks       GoalTemplateMilestoneSubtask[]
  tips           GoalTemplateMilestoneTip[]

  @@index([goalTemplateId, position])
}

model GoalTemplateMilestoneSubtask {
  id                     String                @id @default(uuid())
  goalTemplateMilestoneId String
  title                  String
  position               Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  goalTemplateMilestone  GoalTemplateMilestone @relation(fields: [goalTemplateMilestoneId], references: [id], onDelete: Cascade)

  @@index([goalTemplateMilestoneId, position])
}

model GoalTemplateMilestoneTip {
  id                     String                @id @default(uuid())
  goalTemplateMilestoneId String
  text                   String
  position               Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  goalTemplateMilestone  GoalTemplateMilestone @relation(fields: [goalTemplateMilestoneId], references: [id], onDelete: Cascade)

  @@index([goalTemplateMilestoneId, position])
}

model GoalTemplateDetail {
  id             String                       @id @default(uuid())
  goalTemplateId String
  label          String
  value          String
  visibility     GoalTemplateDetailVisibility
  position       Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  goalTemplate   GoalTemplate                 @relation(fields: [goalTemplateId], references: [id], onDelete: Cascade)

  @@index([goalTemplateId, visibility, position])
}

model Quest {
  id           String         @id @default(uuid())
  userId       String
  title        String
  description  String?
  type         QuestType
  category     QuestCategory
  difficulty   GoalDifficulty @default(EASY)
  xpReward     Int            @default(0)
  targetCount  Int            @default(1)
  currentCount Int            @default(0)
  streakCount  Int            @default(0)
  isCustom     Boolean        @default(false)
  completed    Boolean        @default(false)
  completedAt  DateTime?
  periodStart  DateTime?
  resetsAt     DateTime?
  position     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, type, completed])
  @@index([userId, position])
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalTemplateCategory {
  JOB
  STUDY
  TRAINING
  HEALTH
  RELATIONSHIP
  FINANCE
}

enum GoalTemplateDetailVisibility {
  SUMMARY
  DETAIL
  BOTH
}

enum GoalDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum QuestType {
  DAILY
  WEEKLY
}

enum QuestCategory {
  TRAINING
  HEALTH
  PRODUCTIVITY
  MINDFULNESS
  CAREER
  CREATIVITY
  SOCIAL
  FINANCE
}
